{
  "name": "@iavofficial/frontend-framework",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "contributors": [
    { "name": "Joerg Jonas Krahn", "email": "joerg.jonas.krahn@iav.de" },
    { "name": "Daniel Helfenstein", "email": "daniel.helfenstein@iav.de" },
    { "name": "Christian Becke", "email": "christian.becke@iav.de" },
    { "name": "Mike Wegele", "email": "mike.wegele@iav.de" }
  ],
  "scripts": {
    "setup:root": "node -e \"const fs=require('fs');process.exit(fs.existsSync('package-lock.json')?0:1)\" && npm ci || npm install",
    "checkout-docs:root": "./scripts/unix/docs_generation/copy-root-docs-and-prepare.sh",
    "dev": "turbo run dev build-live",
    "docs": "cd docs && npm run dev",
    "build:docs": "cd docs && npm run build",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write \"{packages,apps,docs}/**/src/**/*.{ts,tsx,js,jsx,json,html,css}\"",
    "release": "turbo run release --concurrency=1",
    "generate-docs": "turbo run generate-docs",
    "postinstall": "node scripts/fix-lockfile-registry.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "cross-env": "^10.1.0",
    "semantic-release": "^25.0.2",
    "semantic-release-monorepo": "^8.0.2",
    "turbo": "^2.6.1",
    "prettier": "^3.7.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@svgr/babel-plugin-transform-svg-component": "^8.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "vite": "^7.3.2",
    "vite-plugin-svgr": "^4.5.0",
    "babel-plugin-inline-react-svg": "^2.0.2",
    "jest": "^30.2.0",
    "@eslint/js": "^9.39.1"

  },
  "packageManager": "npm@10.8.2"
}

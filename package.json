{
  "name": "@iavofficial/frontend-framework",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Joerg Jonas Krahn",
      "email": "joerg.jonas.krahn@iav.de"
    },

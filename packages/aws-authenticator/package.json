{
  "name": "@iavofficial/frontend-framework-aws-authenticator",
  "version": "1.0.0-dev.6",
  "private": false,
  "license": "Apache-2.0",
  "description": "This package provides AWS authentication using AWS Cognito.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iavofficial/IAVFrontendFramework",
    "directory": "packages/aws-authenticator"
  },
  "scripts": {
    "setup": "npm i",
    "build": "sh ../../scripts/unix/packages/build.sh",
    "build:dev": "..\\..\\scripts\\win\\build-once.bat",
    "build-live": "..\\..\\scripts\\win\\build-live.bat",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.{js,ts,tsx}",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" && prettier --write \"docs/*\"",
    "release": "npx semantic-release",
    "generate-docs": "../../scripts/unix/docs_generation/generate-docs-for-package.sh",
    "deps:update:minor": "npx npm-check-updates --target minor -u",
    "audit:fix": "npm audit fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "iav-frontendframework",
    "aws authenticator"
  ],
  "dependencies": {
    "@iavofficial/frontend-framework-shared": "*",
    "@reduxjs/toolkit": "^2.12.0",
    "aws-amplify": "^6.20.0",
    "glob": "^13.0.6",
    "react-redux": "^9.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "files": [
    "./dist",
    "./package.json",
    "./LICENSE",
    "./NOTICE.md",
    "./SBOM.spdx",
    "./README.md"
  ],
  "exports": {
    "./awsAuthenticatorModule": "./dist/awsAuthenticatorModule.js",
    "./cognitoService": "./dist/cognitoService.js",
    "./awsAuthenticatorTypes": "./dist/awsAuthenticatorTypes.js",
    "./awsAuthenticationView": "./dist/components/awsAuthenticationView.js"
  },
  "typesVersions": {
    "*": {
      "./awsAuthenticatorModule": [
        "./dist/awsAuthenticatorModule.d.ts"
      ],
      "./cognitoService": [
        "./dist/cognitoService.d.ts"
      ],
      "./awsAuthenticatorTypes": [
        "./dist/awsAuthenticatorTypes.d.ts"
      ],
      "./awsAuthenticationView": [
        "./dist/components/awsAuthenticationView.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

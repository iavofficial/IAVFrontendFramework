{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build-live": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "release": {
      "dependsOn": ["build"],
      "env": ["GITHUB_TOKEN", "NPM_TOKEN"],
      "cache": false
    },
    "generate-docs": {
      "cache": false
    }
  }
}
